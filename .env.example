# Hugging Face Space that serves the OCR model
HF_SPACE_ID=kevansoon/PaddleOCR

# Only needed if the Space is private
# HF_TOKEN=hf_xxx

# Vercel sends this as the Bearer token on cron hits — set it in project env
# CRON_SECRET=xxx

# Public URL of the scale camera frame; the hourly capture OCRs it when set
# SCALE_PHOTO_URL=https://...
